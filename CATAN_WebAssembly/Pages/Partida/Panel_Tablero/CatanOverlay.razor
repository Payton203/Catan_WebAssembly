@implements IAsyncDisposable
@inject IJSRuntime JS
@inject Jugador_Class Jugador_

<div class="catan-overlay-host" @ref="_ref"
     style="transform: translate(@F(OffsetX)px, @F(OffsetY + _autoOffsetY)px);">
    @if (_vertices.Count > 0)
    {
        <svg width="100%" height="@F(_svgHeight)" style="overflow:visible;">

            @* ── Muelles de puertos (debajo del resto) ── *@
            @foreach (var port in _ports)
            {
                <line x1="@F(port.V1X)" y1="@F(port.V1Y)" x2="@F(port.X)" y2="@F(port.Y)"
                      stroke="#8B6914" stroke-width="@F(_ss * 0.18)"
                      stroke-dasharray="@F(_ss * 0.35) @F(_ss * 0.18)"
                      stroke-linecap="round" />
                <line x1="@F(port.V2X)" y1="@F(port.V2Y)" x2="@F(port.X)" y2="@F(port.Y)"
                      stroke="#8B6914" stroke-width="@F(_ss * 0.18)"
                      stroke-dasharray="@F(_ss * 0.35) @F(_ss * 0.18)"
                      stroke-linecap="round" />
            }

            @* ── Aristas ── *@
            @foreach (var edge in _edges)
            {
                <g class="o-edge @(edge.HasRoad ? "o-edge--road" : "")"
                   transform="translate(@F(edge.X),@F(edge.Y)) rotate(@F(edge.Angle))"
                   @onclick="() => ClickEdge(edge)">
                    @* x="@F(-_rw / 2)" y="@F(-_rl / 2)" width="@F(_rw)" height="@F(_rl)"*@
                    @if (edge.HasRoad)
                    {
                    <svg x="@F(-_rl * 0.26)" y="@F(-_rl * 0.26)" width="@F(_rl * 0.55)" height="@F(_rl * 0.55)"
                         viewBox="0 0 32 32">
                            @((MarkupString)SvgIcons.SVGConColor(SvgIcons.SVG_Road, "","red"))
                    </svg>
                    }
                    else
                    {
                        <rect x="@F(-_rw)"
                        y="@F(-_rl / 2)"
                        width="@F(_rw * 2)"
                        height="@F(_rl)"
                        fill="#FF0000"
                        fill-opacity=" 0.1"/>                    
                    }

                    <text font-size="@F(_rw * 1.5)"
                          text-anchor="middle"
                          dominant-baseline="central"
                          fill="red"
                          pointer-events="none"
                          transform="rotate(@F(-edge.Angle))">@edge.Id</text>
                </g>
            }

            @* ── Vértices ── *@
            @foreach (var v in _vertices)
            {
                <g class="o-vertex @(v.Structure != StructureType.None ? "o-vertex--built" : "")"
                   transform="translate(@F(v.X),@F(v.Y))"
                   @onclick="() => ClickVertex(v)">
                    @if (v.Structure == StructureType.None)
                    {
                        <circle r="@F(_vr * 0.55)" class="o-dot" stroke-width="0.8" />
                    }
                    else if (v.Structure == StructureType.Settlement)
                    {
                        <g transform="translate(@F(_ss * -1.12), @F(_ss * -0.8)) scale(@F(_ss * 0.08))">
                            @SvgIcons.SVGConColor(SvgIcons.SVG_Settlement, "","White")
                        </g>
                    }
                    else
                    {
                                             //offset X, Y
                        <g transform="translate(@F(_ss * -1.02), @F(_ss * -0.93)) scale(@F(_ss * 0.07))">
                            @((MarkupString)SvgIcons.SVGConColor_Multiples_instancias(SvgIcons.SVG_City, "Outline", v.PlayerColor, v.Id.ToString()))
                        </g>
                    }
                    <text font-size="@F(_vr * 0.9)"
                          text-anchor="middle"
                          dominant-baseline="central"
                          fill="White"
                          pointer-events="none">@v.Id</text>
                </g>
            }

            @* ── Barcos de puertos (encima del resto) ── *@
            @foreach (var port in _ports)
            {
                <g class="o-port"
                   transform="translate(@F(port.X),@F(port.Y)) rotate(@F(port.Angle)) scale(1.7)"
                   @onclick="() => ClickPort(port)">

                    @* Casco *@
                    <ellipse cx="0" cy="@F(_ss * 0.15)" rx="@F(_ss)" ry="@F(_ss * 0.28)"
                             fill="#8B4513" stroke="#5C2E00" stroke-width="0.5" />
                    <ellipse cx="0" cy="@F(_ss * 0.08)" rx="@F(_ss * 0.82)" ry="@F(_ss * 0.14)"
                             fill="#A0522D" opacity="0.5" />

                    @* Mástil *@
                    <line x1="0" y1="@F(_ss * 0.12)" x2="0" y2="@F(-_ss * 1.8)"
                          stroke="#5C3D11" stroke-width="@F(_ss * 0.1)" stroke-linecap="round" />

                    @* Vela rectangular *@
                    <polygon points="@SailPoints()"
                             fill="rgba(255,245,220,0.93)" stroke="#C8B87A" stroke-width="0.8" />

                    @* Badge del recurso en la vela *@
                    <g transform="translate(@F(_ss * -0.03), @F(-_ss * 1.26)) scale(@F(_ss * 0.04))">
                        @((MarkupString)PortIcon(port.Type))
                    </g>
                    <text x="@F(_ss * 0.55)" y="@F(-_ss * 1.41)"
                          font-size="@F(_ss * 0.38)" font-weight="bold"
                          text-anchor="middle" dominant-baseline="central"
                          fill="Black" pointer-events="none">
                        @PortLabel(port.Type)
                    </text>
                </g>
            }

        </svg>
    }
</div>

@code {
    // ── Parámetros ─────────────────────────────────────────────────────────────
    [Parameter] public int[] RowLayout { get; set; } = { 3, 4, 5, 4, 3 };
    [Parameter] public double SizeScale { get; set; } = 1.0;
    [Parameter] public double OverlayScale { get; set; } = 1.0;
    [Parameter] public double GapRatio { get; set; } = 0.05;
    [Parameter] public double OffsetX { get; set; } = 0;
    [Parameter] public double OffsetY { get; set; } = 0;
    [Parameter] public double OffsetX_Debug { get; set; } = 0;
    [Parameter] public double OffsetY_Debug { get; set; } = 0;
    [Parameter] public double Scale_Debug { get; set; } = 1;
    [Parameter] public double Angle_Debug { get; set; } = 1;

    [Parameter] public EventCallback<HexVertex> OnVertexClick { get; set; }
    [Parameter] public EventCallback<HexEdge> OnEdgeClick { get; set; }
    [Parameter] public EventCallback<HexPort> OnPortClick { get; set; }

    [Parameter] public EventCallback<(List<HexVertex> Vertices, List<HexEdge> Edges)> OnGeometryReady { get; set; }
    [Parameter] public EventCallback<List<HexPort>> OnPortsReady { get; set; }

    [Parameter] public ElementReference TargetRef { get; set; }
    // ── Estado ─────────────────────────────────────────────────────────────────
    private ElementReference _ref;
    private DotNetObjectReference<CatanOverlay>? _selfRef;

    private bool _geometryInitialized = false;

    private List<HexVertex> _vertices = new();
    private List<HexEdge> _edges = new();
    private List<HexPort> _ports = new();

    private double _containerWidth = 0;
    private double _svgHeight = 0;
    private double _autoOffsetY = 0;

    // Tamaños derivados del hexSize actual
    private double _vr = 10;   // vertex radius
    private double _rl = 50;   // road length
    private double _rw = 5;    // road width
    private double _ss = 14;   // ship size

    // ── Posiciones estándar de los 9 puertos de Catan ─────────────────────────
    // Formato: (índice plano del HexCell(Id.HexCell-1), índice de arista 0-5, tipo de puerto)
    // Podés cambiar el Type desde Layout_Partida vía OnPortsReady.
    private static readonly (int HexIdx, int EdgeIdx, PortType Type)[] PortDefinitions =
    {
        (0,  5, PortType.Sheep),         // superior-izquierdo
        (1,  0, PortType.ThreeToOne),   // superior-centro
        (3,  4, PortType.ThreeToOne),   // superior-derecho
        (6,  0, PortType.Rock),          // derecho-superior
        (11,  1, PortType.ThreeToOne),   // derecho-medio
        (12, 4, PortType.Wheat),        // derecho-inferior
        (15, 2, PortType.Brick),        // inferior
        (16, 3, PortType.ThreeToOne),   // inferior-izquierdo
        (17,  2, PortType.Wood),         // izquierdo
    };

    // ── Formato invariant (SVG no acepta coma decimal) ────────────────────────
    private static string F(double v) =>
        v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

    // ── Lifecycle ──────────────────────────────────────────────────────────────
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("hexGridInterop.observeParent", _ref, _selfRef);
        }
    }

    protected override void OnParametersSet()
    {
        if (_containerWidth > 0) Recompute(_containerWidth);
    }

    [JSInvokable]
    public void OnContainerResized(double widthPx)
    {
        _containerWidth = widthPx;
        Recompute(widthPx);
        StateHasChanged();
    }

    // ── Motor de cálculo ───────────────────────────────────────────────────────
    private void Recompute(double cw)
    {
        int maxCols = RowLayout.Max();
        double hexSize = Math.Clamp(cw * 0.90 / maxCols * SizeScale * OverlayScale, 30, 200);
        double H = hexSize * 1.1547;
        _vr = hexSize * 0.11;   // vertex radius  → radio de los círculos en los vértices
        _rl = hexSize * 0.50;   // road length    → largo de los caminos
        _rw = hexSize * 0.055;  // road width     → ancho de los caminos
        _ss = hexSize * 0.14;   // settlement/structure scale → tamaño de íconos (poblados, puertos, ciudad)
        _svgHeight = H + (RowLayout.Length - 1) * H * 0.75;
        _autoOffsetY = GapRatio * hexSize * -0.3;

        var centers = GetCenters(cw, hexSize, H);

        if (!_geometryInitialized)
        {
            _vertices = BuildVertices(centers, hexSize, H);
            _edges = BuildEdges(centers, hexSize, H);
            _ports = BuildPorts(centers, hexSize, H);

            if (OnGeometryReady.HasDelegate)
                InvokeAsync(() => OnGeometryReady.InvokeAsync((_vertices, _edges)));

            if (OnPortsReady.HasDelegate)
                InvokeAsync(() => OnPortsReady.InvokeAsync(_ports));

            _geometryInitialized = true;
        }
        else
        {
            UpdateVertexPositions(centers, hexSize, H);
            UpdateEdgePositions(centers, hexSize, H);
            UpdatePortPositions(centers, hexSize, H);
        }
    }

    // ── Centros — gap = 0 ─────────────────────────────────────────────────────
    private List<(double X, double Y)> GetCenters(double cw, double s, double H)
    {
        var list = new List<(double, double)>();
        int maxCols = RowLayout.Max();
        double pad = 0; // Esta centrado, no tiene padding
        double cy = H / 2;

        for (int r = 0; r < RowLayout.Length; r++)
        {
            int cols = RowLayout[r];
            double indent = (maxCols - cols) / 2.0 * s;
            for (int c = 0; c < cols; c++)
                list.Add((pad + indent + c * s + s / 2, cy));
            if (r < RowLayout.Length - 1)
                cy += H * 0.75;
        }
        return list;
    }

    // ── Vértices ───────────────────────────────────────────────────────────────
    private static (double dx, double dy)[] VOffsets(double s, double H) =>
        new[] { (0d, -H / 2), (s / 2, -H / 4), (s / 2, H / 4), (0d, H / 2), (-s / 2, H / 4), (-s / 2, -H / 4) };

    private List<HexVertex> BuildVertices(List<(double X, double Y)> centers, double s, double H)
    {
        var off = VOffsets(s, H);
        var dict = new Dictionary<string, HexVertex>();
        foreach (var (cx, cy) in centers)
            foreach (var (dx, dy) in off)
            {
                string key = $"{(int)Math.Round(cx + dx)},{(int)Math.Round(cy + dy)}";
                if (!dict.ContainsKey(key))
                    dict[key] = new HexVertex { Position_Id = key, X = cx + dx, Y = cy + dy };
            }
        return dict.Values.ToList();
    }

    private void UpdateVertexPositions(List<(double X, double Y)> centers, double s, double H)
    {
        var off = VOffsets(s, H);
        var seen = new HashSet<string>();
        var pos = new List<(double X, double Y)>();
        foreach (var (cx, cy) in centers)
            foreach (var (dx, dy) in off)
            {
                string key = $"{(int)Math.Round(cx + dx)},{(int)Math.Round(cy + dy)}";
                if (seen.Add(key)) pos.Add((cx + dx, cy + dy));
            }
        for (int i = 0; i < Math.Min(_vertices.Count, pos.Count); i++)
        { _vertices[i].X = pos[i].X; _vertices[i].Y = pos[i].Y; }
    }

    // ── Aristas ────────────────────────────────────────────────────────────────
    private static readonly double[] EdgeAngles = { -60, 0, +60, -60, 0, +60 };

    private List<HexEdge> BuildEdges(List<(double X, double Y)> centers, double s, double H)
    {
        var off = VOffsets(s, H);
        var dict = new Dictionary<string, HexEdge>();
        foreach (var (cx, cy) in centers)
            for (int i = 0; i < 6; i++)
            {
                int j = (i + 1) % 6;
                double ax = cx + off[i].dx, ay = cy + off[i].dy;
                double bx = cx + off[j].dx, by = cy + off[j].dy;
                string ka = $"{(int)Math.Round(ax)},{(int)Math.Round(ay)}";
                string kb = $"{(int)Math.Round(bx)},{(int)Math.Round(by)}";
                string key = string.Compare(ka, kb) < 0 ? $"{ka}|{kb}" : $"{kb}|{ka}";
                if (!dict.ContainsKey(key))
                    dict[key] = new HexEdge { Position_Id = key, X = (ax + bx) / 2, Y = (ay + by) / 2, Angle = EdgeAngles[i] };
            }
        return dict.Values.ToList();
    }

    private void UpdateEdgePositions(List<(double X, double Y)> centers, double s, double H)
    {
        var off = VOffsets(s, H);
        var seen = new HashSet<string>();
        var pos = new List<(double X, double Y, double A)>();
        foreach (var (cx, cy) in centers)
            for (int i = 0; i < 6; i++)
            {
                int j = (i + 1) % 6;
                double ax = cx + off[i].dx, ay = cy + off[i].dy, bx = cx + off[j].dx, by = cy + off[j].dy;
                string ka = $"{(int)Math.Round(ax)},{(int)Math.Round(ay)}";
                string kb = $"{(int)Math.Round(bx)},{(int)Math.Round(by)}";
                string key = string.Compare(ka, kb) < 0 ? $"{ka}|{kb}" : $"{kb}|{ka}";
                if (seen.Add(key)) pos.Add(((ax + bx) / 2, (ay + by) / 2, EdgeAngles[i]));
            }
        for (int i = 0; i < Math.Min(_edges.Count, pos.Count); i++)
        { _edges[i].X = pos[i].X; _edges[i].Y = pos[i].Y; _edges[i].Angle = pos[i].A; }
    }

    // ── Puertos ────────────────────────────────────────────────────────────────

    // Normales hacia afuera del board por arista (para posicionar el barco)
    private static readonly (double nx, double ny)[] OutwardNormals =
    {
        ( 0.5, -0.866),  // E0
        ( 1.0,  0.0  ),  // E1
        ( 0.5,  0.866),  // E2
        (-0.5,  0.866),  // E3
        (-1.0,  0.0  ),  // E4
        (-0.5, -0.866),  // E5
    };

    private List<HexPort> BuildPorts(List<(double X, double Y)> centers, double s, double H)
    {
        var off = VOffsets(s, H);
        var ports = new List<HexPort>();
        double dist = s * 0.65;  // distancia del barco al centro de la arista

        foreach (var (hexIdx, edgeIdx, type) in PortDefinitions)
        {
            if (hexIdx >= centers.Count) continue;

            var (cx, cy) = centers[hexIdx];
            int j = (edgeIdx + 1) % 6;

            double v1x = cx + off[edgeIdx].dx, v1y = cy + off[edgeIdx].dy;
            double v2x = cx + off[j].dx, v2y = cy + off[j].dy;
            double midX = (v1x + v2x) / 2, midY = (v1y + v2y) / 2;

            var (nx, ny) = OutwardNormals[edgeIdx];

            ports.Add(new HexPort
            {
                Id = $"port_{hexIdx}_{edgeIdx}",
                Type = type,
                X = midX + nx * dist,
                Y = midY + ny * dist,
                Angle = EdgeAngles[edgeIdx],
                V1X = v1x,
                V1Y = v1y,
                V2X = v2x,
                V2Y = v2y,
            });
        }
        return ports;
    }

    private void UpdatePortPositions(List<(double X, double Y)> centers, double s, double H)
    {
        var off = VOffsets(s, H);
        double dist = s * 0.65;

        for (int p = 0; p < _ports.Count && p < PortDefinitions.Length; p++)
        {
            var (hexIdx, edgeIdx, _) = PortDefinitions[p];
            if (hexIdx >= centers.Count) continue;

            var (cx, cy) = centers[hexIdx];
            int j = (edgeIdx + 1) % 6;

            double v1x = cx + off[edgeIdx].dx, v1y = cy + off[edgeIdx].dy;
            double v2x = cx + off[j].dx, v2y = cy + off[j].dy;
            double midX = (v1x + v2x) / 2, midY = (v1y + v2y) / 2;
            var (nx, ny) = OutwardNormals[edgeIdx];

            _ports[p].X = midX + nx * dist; _ports[p].Y = midY + ny * dist;
            _ports[p].V1X = v1x; _ports[p].V1Y = v1y;
            _ports[p].V2X = v2x; _ports[p].V2Y = v2y;
        }
    }

    // ── Shapes SVG ─────────────────────────────────────────────────────────────

    private string Settlement()
    {
        double s = _vr; var ic = System.Globalization.CultureInfo.InvariantCulture;
        string V(double v) => v.ToString("F1", ic);
        return $"0,{V(-s * 1.2)} {V(s)},{V(-s * 0.1)} {V(s)},{V(s * 0.9)} {V(-s)},{V(s * 0.9)} {V(-s)},{V(-s * 0.1)}";
    }

    private string City()
    {
        double s = _vr; var ic = System.Globalization.CultureInfo.InvariantCulture;
        string V(double v) => v.ToString("F1", ic);
        return $"{V(-s * 1.1)},{V(-s * 1.1)} {V(-s * 0.1)},{V(-s * 1.1)} {V(-s * 0.1)},{V(-s * 0.2)} " +
               $"{V(s * 0.45)},{V(-s)} {V(s * 1.1)},{V(-s * 0.2)} {V(s * 1.1)},{V(s * 0.9)} {V(-s * 1.1)},{V(s * 0.9)}";
    }

    // Vela rectangular (en coords locales del barco, mástil en x=0)
    private string SailPoints()
    {
        double s = _ss; var ic = System.Globalization.CultureInfo.InvariantCulture;
        string V(double v) => v.ToString("F1", ic);
        // Puntos: superior-izq, superior-der, inferior-der, inferior-izq
        return $"{V(-s * 0.05)},{V(-s * 1.7)} {V(s * 1.2)},{V(-s * 1.6)} {V(s * 1.1)},{V(-s * 0.1)} 0,{V(-s * 0.18)}";
        /*
        (-s*0.05, -s*1.7)   ← esquina superior-izquierda (arriba del mástil, izq)
        ( s*1.2,  -s*1.6)   ← esquina superior-derecha   (arriba del mástil, der)
        ( s*1.1,  -s*0.1)   ← esquina inferior-derecha   (abajo de la vela, der)
        (  0,     -s*0.18)  ← esquina inferior-izquierda  (abajo de la vela, pegada al mástil)
        */
    }

    // Color por tipo de puerto
    private static string PortIcon(PortType type) => type switch
    {
        // PortType.Brick => "#CC4400",
        PortType.Wood => SvgIcons.SVG_Wood,
        PortType.Sheep => SvgIcons.SVG_Sheep,
        // PortType.Wheat => "#DAA520",
        // PortType.Rock => "#708090",
        _ => SvgIcons.SVG_Missing_Texture,  // 3:1
    };

    // Etiqueta por tipo de puerto
    private static string PortLabel(PortType type) => type switch
    {
        PortType.ThreeToOne => "3:1",
        _ => "2:1",
    };

    // ── Clicks ────────────────────────────────────────────────────────────────
    private async Task ClickVertex(HexVertex v) { if (OnVertexClick.HasDelegate) await OnVertexClick.InvokeAsync(v); }
    private async Task ClickEdge(HexEdge e) { if (OnEdgeClick.HasDelegate) await OnEdgeClick.InvokeAsync(e); }
    private async Task ClickPort(HexPort p) { if (OnPortClick.HasDelegate) await OnPortClick.InvokeAsync(p); }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("hexGridInterop.unobserve", _ref); }
        catch (JSDisconnectedException) { }
        _selfRef?.Dispose();
    }
}
