@using CATAN_WebAssembly.Pages.Partida.Panel_Historial
@using CATAN_WebAssembly.Pages.Partida
@using CATAN_WebAssembly.Services
@inject HistorialService Historial_
@inject Jugador_Class Jugador_
@inject PartidaService PartidaService_
@inject CatanBoardState BoardState
@implements IDisposable

<div class="panel-dados-contenido">
    <div style="align-items:center; justify-content:space-evenly; display:flex; flex-direction:row; width: 100%; height: 100%; gap: 5%;">
        <div class="display-dado"> @(Dado_1?.ToString() ?? "—") </div>
        <div class="display-dado"> + </div>
        <div class="display-dado"> @(Dado_2?.ToString() ?? "—") </div>
        <div class="display-dado"> = </div>
        <div class="display-dado"> @(Suma_Dados?.ToString() ?? "—") </div>
    </div>
</div>
<button class="boton-tirar-dados" disabled="@BoardState.Replay" @onclick=Tirar_Dados> TIRAR_DADOS</button>
@code {
    private int _dado1 = 5;
    private int _dado2 = 4;
    private int? Dado_1 => BoardState.Replay ? PartidaService_.UltimaTirada?.Dado1 : _dado1;
    private int? Dado_2 => BoardState.Replay ? PartidaService_.UltimaTirada?.Dado2 : _dado2;
    private int? Suma_Dados => BoardState.Replay ? PartidaService_.UltimaTirada?.Resultado_Dados : _dado1 + _dado2;
    protected override void OnInitialized() => PartidaService_.OnChange += Refrescar;
    private void Refrescar() => InvokeAsync(StateHasChanged);
    public void Dispose() => PartidaService_.OnChange -= Refrescar;
    private void Tirar_Dados()
    {
        Random random = new Random();
        _dado1 = random.Next(1, 7);
        _dado2 = random.Next(1, 7);
        Historial_.AgregarEvento(new HistorialEvento { Tipo = TipoEvento.Tirada_Dados, Jugador = Jugador_.TurnoJugador().Nombre, Resultado_Dados = Suma_Dados, Dado1 = _dado1, Dado2 = _dado2 });
    }
}
