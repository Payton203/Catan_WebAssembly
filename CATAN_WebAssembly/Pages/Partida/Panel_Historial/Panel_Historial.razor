@using CATAN_WebAssembly.Layout
@using CATAN_WebAssembly.Services
@using CATAN_WebAssembly.Pages.Partida
@using CATAN_WebAssembly.Pages.Partida.Panel_Tablero
@inject HistorialService Historial_
@inject CatanBoardState BoardState

<div class="panel-historial-contenido">
    @foreach( HistorialEvento evento in Historial_.Historial.AsEnumerable().Reverse() )
    {
        <div class="contenedor-evento">
            <span class="texto-evento"> @Texto_evento(evento) </span>
            <div class="contenedor-momento"> @evento.Momento</div>
        </div>
    }
</div>
@code {

    protected override void OnInitialized()
    {
        Historial_.AgregarEvento(new HistorialEvento
        {
            Tipo = TipoEvento.Construccion_Estructura,
            Jugador = "percha",
            Id_Posicion_construccion = 10,
            Estructura_Vertice = StructureType.Settlement
        });

        // 2. Construcción de Carretera
        Historial_.AgregarEvento(new HistorialEvento
        {
            Tipo = TipoEvento.Construccion_Carretera,
            Jugador = "Carlos",
            Id_Posicion_construccion = 14
        });

        // 3. Tirada de Dados
        Historial_.AgregarEvento(new HistorialEvento
        {
            Tipo = TipoEvento.Tirada_Dados,
            Jugador = "Santiago",
            Resultado_Dados = 8
        });

        // 4. Producción de Recursos
        Historial_.AgregarEvento(new HistorialEvento
        {
            Tipo = TipoEvento.Produccion_Recursos,
            Jugador = "percha",
            Recursos_Recibidos = new Dictionary<ResourceType, int>
    {
        { ResourceType.Wood, 1 },
        { ResourceType.Wheat, 2 }
    }
        });

        // 5. Fin de Turno
        Historial_.AgregarEvento(new HistorialEvento
        {
            Tipo = TipoEvento.Fin_De_Turno,
            Jugador = "Carlos"
        });

        // 6. Comercio con la Banca / Puerto
        Historial_.AgregarEvento(new HistorialEvento
        {
            Tipo = TipoEvento.Comercio_Banca,
            Jugador = "Santiago",
            Recursos_Ofrecidos = new Dictionary<ResourceType, int>
    {
        { ResourceType.Wood, 4 }
    },
            Recursos_Recibidos = new Dictionary<ResourceType, int>
    {
        { ResourceType.Rock, 1 }
    }
        });

        // 7. Comercio entre Jugadores
        Historial_.AgregarEvento(new HistorialEvento
        {
            Tipo = TipoEvento.Comercio_Jugadores,
            Jugador = "Santiago",
            Jugador_Objetivo = "percha",
            Recursos_Ofrecidos = new Dictionary<ResourceType, int>
    {
        { ResourceType.Brick, 2 },
        { ResourceType.Sheep, 1 }
    },
            Recursos_Recibidos = new Dictionary<ResourceType, int>
    {
        { ResourceType.Rock, 1 }
    }
        });

        // 8. Mover el Ladrón
        Historial_.AgregarEvento(new HistorialEvento
        {
            Tipo = TipoEvento.Mover_Ladron,
            Jugador = "Carlos",
            Id_Posicion_construccion = 5 // ID del hexágono
        });

        // 9. Robar Recurso a un Jugador
        Historial_.AgregarEvento(new HistorialEvento
        {
            Tipo = TipoEvento.Robar_Recurso,
            Jugador = "Carlos",
            Jugador_Objetivo = "Santiago",
            Recursos_Recibidos = new Dictionary<ResourceType, int>
    {
        { ResourceType.Wood, 1 }
    }
        });

        // 10. Descarte por un 7
        Historial_.AgregarEvento(new HistorialEvento
        {
            Tipo = TipoEvento.Descarte_Por_Siete,
            Jugador = "percha",
            Recursos_Ofrecidos = new Dictionary<ResourceType, int>
    {
        { ResourceType.Wood, 1 },
        { ResourceType.Brick, 1 },
        { ResourceType.Sheep, 1 },
        { ResourceType.Wheat, 1 },
        { ResourceType.Rock, 1 }
    }
        });

        // 11. Comprar Carta de Desarrollo
        Historial_.AgregarEvento(new HistorialEvento
        {
            Tipo = TipoEvento.Comprar_Carta_Desarrollo,
            Jugador = "Santiago"
        });

        // 12. Jugar Carta de Desarrollo
        Historial_.AgregarEvento(new HistorialEvento
        {
            Tipo = TipoEvento.Jugar_Carta_Desarrollo,
            Jugador = "Santiago",
            Tipo_Carta_Desarrollo = TiposCartasDesarrollo.Caballero
        });

        // 13. Obtener Gran Ruta (Ruta Más Larga)
        Historial_.AgregarEvento(new HistorialEvento
        {
            Tipo = TipoEvento.Obtener_Gran_Ruta,
            Jugador = "Carlos"
        });

        // 14. Obtener Ejército (Ejército Más Grande)
        Historial_.AgregarEvento(new HistorialEvento
        {
            Tipo = TipoEvento.Obtener_Ejercito,
            Jugador = "Santiago"
        });

        // 15. Victoria
        Historial_.AgregarEvento(new HistorialEvento
        {
            Tipo = TipoEvento.Victoria,
            Jugador = "Santiago",
            Puntos_Victoria = 10
        });

        Historial_.OnAccion += HandleChange;
        //se suscribe, para que cada vez que algún valor cambie, invoque el metodo HandleChange

    }

    private void HandleChange()
    {
        StateHasChanged();
        // vuelve a renderizar el Layout
    }

    public void Dispose()
    {
        Historial_.OnAccion -= HandleChange;
    }

    private string Texto_evento(HistorialEvento evento)
    {
        string textoResultado;

        switch (evento.Tipo) //textos generales, se ven iguales en la partida, que post partida.
        {
            // Construcción
            case TipoEvento.Construccion_Estructura:
                textoResultado = $"{evento.Jugador} {Texto_Estructura(evento.Estructura_Vertice)} en la posición {evento.Id_Posicion_construccion}";
                break;

            case TipoEvento.Construccion_Carretera:
                textoResultado = $"{evento.Jugador} construyó una Carretera en la arista {evento.Id_Posicion_construccion}";
                break;

            // Turno / Dados
            case TipoEvento.Tirada_Dados:
                textoResultado = $"{evento.Jugador} tiró los dados y sacó: {evento.Resultado_Dados}";
                break;

            case TipoEvento.Produccion_Recursos:
                textoResultado = $"{evento.Jugador} recibió: {Texto_Lista_Recursos(evento.Recursos_Recibidos)}";
                break;

            case TipoEvento.Fin_De_Turno:
                textoResultado = $"{evento.Jugador} finalizó su turno";
                break;

            // Comercio
            case TipoEvento.Comercio_Banca:
                textoResultado = $"{evento.Jugador} entregó {Texto_Lista_Recursos(evento.Recursos_Ofrecidos)} a la banca a cambio de {Texto_Lista_Recursos(evento.Recursos_Recibidos)}";
                break;

            case TipoEvento.Comercio_Jugadores:
                textoResultado = $"{evento.Jugador} le dio {Texto_Lista_Recursos(evento.Recursos_Ofrecidos)} a {evento.Jugador_Objetivo} a cambio de {Texto_Lista_Recursos(evento.Recursos_Recibidos)}";
                break;

            // Ladrón
            case TipoEvento.Mover_Ladron:
                textoResultado = $"{evento.Jugador} movió al Ladrón al hexágono {evento.Id_Posicion_construccion}";
                break;

            // Cartas de Desarrollo
            case TipoEvento.Jugar_Carta_Desarrollo:
                textoResultado = $"{evento.Jugador} jugó la carta {Texto_Carta_Desarrollo(evento.Tipo_Carta_Desarrollo)}";
                break;

            // Logros / Final
            case TipoEvento.Obtener_Gran_Ruta:
                textoResultado = $"{evento.Jugador} reclamó el título de La Ruta Más Larga";
                break;

            case TipoEvento.Obtener_Ejercito:
                textoResultado = $"{evento.Jugador} reclamó el título de El Gran Ejército";
                break;

            case TipoEvento.Victoria:
                textoResultado = $"¡{evento.Jugador} alcanzó los {evento.Puntos_Victoria} puntos y ganó la partida!";
                break;

            default:
                textoResultado = "Error 404, no se identificó el tipo de evento";
                break;
        }
        if(BoardState.Replay == false)
        {
            switch (evento.Tipo)
            {
                case TipoEvento.Robar_Recurso:
                textoResultado = $"{evento.Jugador} le robó una carta de recurso a {evento.Jugador_Objetivo}";
                break;
                case TipoEvento.Descarte_Por_Siete:
                    textoResultado = $"{evento.Jugador} tuvo que descartar la mitad de sus recursos por el 7";
                    break;
                case TipoEvento.Comprar_Carta_Desarrollo:
                    textoResultado = $"{evento.Jugador} compró una carta de desarrollo";
                    break;
            }
        }
        else
        {
            switch (evento.Tipo)
            {
                case TipoEvento.Robar_Recurso:
                    textoResultado = $"{evento.Jugador} le robó {Texto_Lista_Recursos(evento.Recursos_Recibidos)} a {evento.Jugador_Objetivo}";
                    break;
                case TipoEvento.Comprar_Carta_Desarrollo:
                    textoResultado = $"{evento.Jugador} compró una carta de desarrollo de {evento.Tipo_Carta_Desarrollo}";
                    break;
                case TipoEvento.Descarte_Por_Siete:
                    textoResultado = $"{evento.Jugador} tuvo que descartar {Texto_Lista_Recursos(evento.Recursos_Ofrecidos)} por el 7";
                    break;
            }
        }
        return textoResultado;
    }

    private string Texto_Lista_Recursos(Dictionary<ResourceType, int>? recursos)
    {
        if (recursos == null || recursos.Count == 0)
            return "nada";

        return string.Join(", ", recursos.Select(r => $"{r.Value}x {Texto_Recurso(r.Key)}"));
    }
    private string Texto_Estructura(StructureType? structure)
    {
        return structure switch
        {
            StructureType.Settlement => "construyó un Poblado",
            StructureType.City => "construyó una Ciudad",
            StructureType.None => "destruyó una Estructura",
            _ => "Error 404, no se identificó el tipo de estructura"
        };
    }

    private string Texto_Recurso(ResourceType? recurso)
    {
        return recurso switch
        {
            ResourceType.Wood => "Madera",
            ResourceType.Brick => "Ladrillo",
            ResourceType.Sheep => "Lana",
            ResourceType.Wheat => "Trigo",
            ResourceType.Rock => "Mineral",
            _ => "Recurso no identificado"
        };
    }

    private string Texto_Carta_Desarrollo(TiposCartasDesarrollo? carta)
    {
        return carta switch
        {
            TiposCartasDesarrollo.Caballero => "Caballero",
            TiposCartasDesarrollo.Carreteras => "Construcción de Carreteras",
            TiposCartasDesarrollo.Invento => "Año de la Abundancia",
            TiposCartasDesarrollo.Monopolio => "Monopolio",
            TiposCartasDesarrollo.Punto_Victoria => "Punto de Victoria",
            _ => "Carta no identificada"
        };
    }
}
