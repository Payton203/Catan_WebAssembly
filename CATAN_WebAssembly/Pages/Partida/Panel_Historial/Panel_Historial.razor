@using CATAN_WebAssembly.Layout
@using CATAN_WebAssembly.Services
@using CATAN_WebAssembly.Pages.Partida
@using CATAN_WebAssembly.Pages.Partida.Panel_Tablero
@inject HistorialService Historial_
@inject Jugador_Class Jugador_
@inject CatanBoardState BoardState
@inject PartidaService PartidaService_

@if(BoardState.Replay == true)
{
    <div class="d-inline-flex" style="gap: 10px; height:fit-content">
        <button style="scale: 2" class="bi bi-caret-left-fill" @onclick="() => Historial_.Anterior_Evento(PartidaService_, BoardState)"></button>
        <button style="scale: 2" class="bi @(_estaReproduciendo ? "bi-pause-fill" : "bi-play-fill")"
                @onclick="ToggleReplay">
        </button>
        <button style="scale: 2" class="bi bi-caret-right-fill" @onclick="() => Historial_.Siguiente_Evento(PartidaService_, BoardState)"></button>
        <button style="scale: 2; margin-left: auto;" class="bi bi-gear" @onclick="ToggleOpciones" title="Configuración">
        </button>
    </div>
}

<div class="menu-container">
    @if (mostrarOpciones)
    {
        <div class="popup-menu">
            <div class="item-left">
                <MudSlider @bind-Value="_intervaloReplayMs" Step="10" Min="250" Max="10000" Color="Color.Primary" Class="flex-grow-1 mx-2"></MudSlider>
            </div>
            <div class="item-right">
                <span>@($"{_intervaloReplayMs} ms")</span>
            </div>
        </div>
    }
</div>

<div class="panel-historial-contenido">
    @{
        // Selecciona qué lista mostrar según el modo
        var listaEventos = BoardState.Replay
            ? Historial_.Historial_Mostrar.AsEnumerable().Reverse()
            : Historial_.Historial.AsEnumerable().Reverse();
    }

    @foreach (HistorialEvento evento in listaEventos)
    {
        <div class="contenedor-evento">
            <span class="texto-evento">@Texto_evento(evento)</span>
            <div class="contenedor-momento">@evento.Momento.ToString("HH:mm:ss")</div>
        </div>
    }
</div>
