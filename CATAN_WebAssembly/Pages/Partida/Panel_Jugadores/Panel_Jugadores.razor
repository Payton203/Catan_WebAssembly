@* 
    Contenido del panel "JUGADORES".
    No dibuja el panel en sí (eso ya lo tenés armado) — solo la lista de tarjetas.
    Al recorrer la lista con @foreach, se adapta solo a la cantidad de jugadores
    que le pases: 2, 3, 4, o los que sean.
*@
@using CATAN_WebAssembly.Layout
@using CATAN_WebAssembly.Pages.Partida
@using CATAN_WebAssembly.Services
@inject Jugador_Class Jugador_
@inject Personalizacion_Pagina Config
@inject Parametros_Iniciales Parametros_Iniciales_
@inject CatanBoardState BoardState
@inject PartidaService PartidaService_
@implements IDisposable

<div class="jugadores-panel-contenido">
    @foreach (Jugador_Class jugador in Jugador_.ListaJugadores)
    {
        <div class="jugador-card @(jugador.EsTurno ? "jugador-card--turno" : "")">

            <div class="jugador-card__header">
                <span class="jugador-card__nombre" style="color: @jugador.Color;">@jugador.Nombre</span>
                @if (jugador.EsTurno)
                {
                    <span class="jugador-card__badge">Turno</span>
                }
                <button @onclick="() => TOGGLE_CARD(jugador)">
                    @if (jugador.Oculto == false)
                    {
                        <i class="bi bi-caret-down"></i>
                    }
                    else
                    {

                        <i class="bi bi-caret-right"></i>
                    }
                </button>
            </div>
            @if (jugador.Oculto == true)
            {
                <div class="jugador-card__puntos">
                    @jugador.PuntosVictoria @(jugador.PuntosVictoria == 1 ? "punto" : "puntos") de victoria
                </div>

                <div class="jugador-card__recursos">
                    @foreach (var recurso in InventarioCatan_ReadOnly.Recursos)
                    {
                        <span class="recurso" title="@recurso.Nombre">
                            <span class="recurso__icono">
                                @SvgIcons.RecursoIcono(recurso.Clave)
                            </span>
                            <span class="recurso__cantidad">@jugador.Recursos[recurso.Clave]</span>
                        </span>
                    }
                </div>

                <div class="jugador-card__desarrollo">
                    @if (BoardState.Replay)
                    {
                        @* Modo replay: se ve todo, separado en mano / jugadas *@
                        <div class="desarrollo-seccion">
                            <span class="desarrollo-seccion__titulo">En mano</span>
                            @FilaCartas(jugador.CartasEnMano, "en mano")
                        </div>
                        <div class="desarrollo-seccion">
                            <span class="desarrollo-seccion__titulo">Jugadas</span>
                            @FilaCartas(jugador.CartasJugadas, "jugadas")
                        </div>
                    }
                    else
                    {
                        @* Modo normal: jugadas visibles, mano solo como cantidad *@
                        <div class="desarrollo-seccion">
                            <span class="desarrollo-seccion__titulo">Jugadas</span>
                            @FilaCartas(jugador.CartasJugadas, "jugadas")
                        </div>
                        <div class="desarrollo-seccion">
                            <span class="desarrollo-seccion__titulo">En mano</span>
                            <span class="recurso" title="Cartas de desarrollo en mano">
                                <span class="recurso__icono">@EmojiDefault</span>
                                <span class="recurso__cantidad">@jugador.TotalCartasEnMano</span>
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>
<div style="margin-top:auto">
    <div style="margin-top: 4px">
        <button class="boton-pasar-turno" style="margin-top: 5px " disabled="@BoardState.Replay" @onclick="PasarTurno"> PASAR </button>
    </div>
</div>


@code {
    private void PasarTurno()
    {
        PartidaService_.Aplicar(new HistorialEvento
        {
            Tipo = TipoEvento.Fin_De_Turno,
            Jugador = Jugador_.TurnoJugador().Nombre
        });
    }

    // Emoji para cartas sin mostrar (en mano, modo normal) o tipos sin emoji asignado
    private const string EmojiDefault = "🎴";

    private static string EmojiDe(TiposCartasDesarrollo tipo) => tipo switch
    {
        TiposCartasDesarrollo.Caballero => "⚔️",
        TiposCartasDesarrollo.Punto_Victoria => "🏆",
        TiposCartasDesarrollo.Carreteras => "🛣️",
        TiposCartasDesarrollo.Invento => "💡",
        TiposCartasDesarrollo.Monopolio => "💰",
        _ => EmojiDefault
    };

    private static string TituloDe(TiposCartasDesarrollo tipo) => tipo switch
    {
        TiposCartasDesarrollo.Caballero => "Caballero",
        TiposCartasDesarrollo.Punto_Victoria => "Punto de victoria",
        TiposCartasDesarrollo.Carreteras => "Construcción de carreteras",
        TiposCartasDesarrollo.Invento => "Invento",
        TiposCartasDesarrollo.Monopolio => "Monopolio",
        _ => "Carta de desarrollo"
    };

    // Una fila con un emoji + cantidad por cada tipo de carta
    private RenderFragment FilaCartas(Dictionary<TiposCartasDesarrollo, int> cartas, string estado) =>
        @<div class="desarrollo-fila">
            @foreach (var tipo in Enum.GetValues<TiposCartasDesarrollo>())
            {
                <span class="recurso" title="@TituloDe(tipo) (@estado)">
                    <span class="recurso__icono">@EmojiDe(tipo)</span>
                    <span class="recurso__cantidad">@(cartas.TryGetValue(tipo, out var c) ? c : 0)</span>
                </span>
            }
        </div>;

    void TOGGLE_CARD(Jugador_Class jugador) => jugador.Oculto = !jugador.Oculto;

    private int ObtenerCantidad(Jugador_Class jugador, ResourceType recurso)
        => jugador.Recursos.TryGetValue(recurso, out var c) ? c : 0;

    protected override void OnInitialized()
    {
        // Suscribirse al evento de PartidaService
        PartidaService_.OnChange += RefrescarUI;
    }

    private async void RefrescarUI()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        PartidaService_.OnChange -= RefrescarUI;
    }
}