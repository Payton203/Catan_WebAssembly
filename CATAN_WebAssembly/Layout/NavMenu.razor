@inject Personalizacion_Pagina Config
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CATAN_WebAssembly</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
       @*  <div class="nav-item px-3">
            <NavLink class="nav-link" href="Partida">
                <span class="bi bi-hexagon-half-nav-menu" aria-hidden="true"></span> Partida
            </NavLink>
        </div> *@
        <div class="nav-item px-3">
            @if(Config.Flag_partida_activa == false)
            {
                <NavLink class="nav-link" href="Lobby">
                    <span class="bi bi-house-gear-nav-menu" aria-hidden="true"></span> Lobby
                </NavLink>
            }
            else
            {
                <NavLink class="nav-link" href="Partida">
                    <span class="bi bi-hexagon-half-nav-menu" aria-hidden="true"></span> Partida
                </NavLink>
            }

        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Arduino_Comunication_Test">
                <span class="bi bi-hexagon-half-nav-menu" aria-hidden="true"></span> Arduino_Comunication_Test
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = false;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
/*    private string? NavMenuCssClass()
    {
        if (collapseNavMenu == true) return "collapse";
        else return null;
    }
*/
    private void ToggleNavMenu()
    {
    collapseNavMenu = !collapseNavMenu;
    }
        protected override void OnInitialized() //cuando se renderiza la pagina, este metodo se ejecuta
        {
            Config.OnChange += HandleChange;
            //se suscribe, para que cada vez que algún valor cambie, invoque el metodo HandleChange
        }
        private void HandleChange()
        {
            StateHasChanged();
            // vuelve a renderizar el Layout
        }

        public void Dispose()
        {
            Config.OnChange -= HandleChange;
            /*se desuscribe del evento, para que Config.OnChange, para que no quede apuntando a esta pagina,
            permitiendo que se desrenderize completamente, previniendo memory leaks*/
        }
}
